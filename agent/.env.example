# Copy to .env and fill in the key. Everything else has a default.
OPENAI_API_KEY=

# The one model for everything. Prices are US$ per million tokens, for the cost figure:
# check them against your provider's price card.
MODEL=gpt-6.1-sol
MODEL_EFFORT=medium
# MODEL_INPUT_USD_PER_MTOK=2
# MODEL_CACHED_INPUT_USD_PER_MTOK=0.1
# MODEL_OUTPUT_USD_PER_MTOK=10

# Tools: none (the floor: one model call), library, or library,web
TOOLS=library

# When a run must stop: rounds of tool calls, seconds, dollars
RUN_ROUNDS=40
RUN_SECONDS=480
RUN_DOLLARS=3

# Search: off ranks by keywords; auto ranks by meaning with the library's vectors (the ready-made
# library has them, so it costs nothing extra)
EMBEDDINGS=off
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIMENSIONS=1024

# The web tools (TOOLS=library,web): web_search needs a Firecrawl key
# FIRECRAWL_API_KEY=

# on: a planted attack page comes first in library searches
PLANTS=off

# The API. With AGENT_KEY set, callers must send Authorization: Bearer <key>
PORT=8787
# AGENT_KEY=
