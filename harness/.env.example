# Copy to .env and fill in the judge's key.
ANTHROPIC_API_KEY=

# The judge, as provider:model. Pick a different family from the agent's model.
# openai:<model> works too, and needs OPENAI_API_KEY.
# JUDGE_MODEL=anthropic:claude-sonnet-5-5
# JUDGE_EFFORT=medium
# US$ per million tokens, for the cost line: check your provider's price card
# JUDGE_INPUT_USD_PER_MTOK=3
# JUDGE_OUTPUT_USD_PER_MTOK=15

# Only if the agent was started with AGENT_KEY
# AGENT_KEY=
